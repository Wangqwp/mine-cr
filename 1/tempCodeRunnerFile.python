def isshu(s):
    g = s % 10
    s //= 10

    while s > 0:
        l = s % 10

        # 奇偶相同
        if g % 2 == l % 2:
            return False

        g = l
        s //= 10

    return True


lis = [10]
q = 11

n = int(input())

while n > len(lis):
    while not isshu(q):
        q += 1

    lis.append(q)
    q += 1

print(lis[-1])